# Ejemplo de configuración. Copia este archivo como .env y rellena los valores.
# El .env real está excluido de Git y nunca debe publicarse.
#
# En Render estas mismas claves se definen como variables de entorno del servicio,
# no como archivo: si no hay .env, dotenv simplemente no hace nada y el servidor
# usa las variables del alojamiento.

# Obligatoria. Cadena de conexión de MongoDB Atlas.
MONGODB_URI=mongodb+srv://usuario:contrasena@cluster.ejemplo.mongodb.net/?retryWrites=true&w=majority

# Opcional. Nombre de la base; por omisión, lectores_parroquia.
MONGODB_DB=lectores_parroquia

# Opcional. Solo hace falta donde no se resuelva el registro SRV de Atlas.
# Si se define, el servidor arma una conexión directa a estos nodos en lugar de
# usar mongodb+srv. Se escriben separados por comas, con su puerto.
# MONGODB_HOSTS=nodo-00.ejemplo.mongodb.net:27017,nodo-01.ejemplo.mongodb.net:27017

# Obligatoria. Contraseña del modo administrador.
# También firma los tokens de sesión: al cambiarla se invalidan todas las sesiones
# administrativas abiertas. Conviene que sea larga y exclusiva de esta aplicación.
ADMIN_PASSWORD=pon-aqui-una-contrasena-larga-y-unica

# Obligatoria en producción. De ella dependen el atributo Secure de la cookie de
# sesión y la cabecera Strict-Transport-Security. Debe servirse por HTTPS.
NODE_ENV=production

# Opcional. Render asigna el puerto automáticamente, así que allí no hace falta.
# En local, por omisión, 3000.
PORT=3000
